{
  "metadata": {
    "short_name": "SPE90408-EX3",
    "long_name": "SPE 90408 Example Model #3 (XYZ accel + XY static gyro 0-17deg + XY continuous gyro 17-150deg)",
    "source": "SPE 90408-MS Torkildsen et al. 2004, Appendix D Table D3/D7",
    "tool_type": "Gyroscopic",
    "revision_number": 5
  },
  "parameters": {
    "inc_min": 0,
    "inc_max": 150,
    "noise_reduction_factor": 0.5,
    "gxy_running_speed": 2160,
    "xy_static_gyro_end_inc": 0.29670597283903605
  },
  "terms": [
    {"name": "AXYZ-B",  "value": 0.005,  "units": "m/s2", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Cos(Inc) / Gfield", "azimuth_formula": "0"},
    {"name": "AZ-B",    "value": 0.005,  "units": "m/s2", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Sin(Inc) / Gfield", "azimuth_formula": "0"},
    {"name": "AXYZ-SF", "value": 0.0005, "units": "-",    "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "1.3 * Sin(Inc) * Cos(Inc)", "azimuth_formula": "0"},
    {"name": "AXYZ-MIS","value": 0.05,   "units": "deg",  "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "1", "azimuth_formula": "0"},

    {"name": "GB1", "value": 0.1, "units": "deg/hr", "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) / (EarthRate * Cos(Latitude) * Cos(Inc))"},
    {"name": "GB2", "value": 0.1, "units": "deg/hr", "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) / (EarthRate * Cos(Latitude))"},
    {"name": "GD1", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) * Sin(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GD2", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) * Cos(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GD3", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) / (EarthRate * Cos(Latitude))"},
    {"name": "GD4", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) * Tan(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GSF", "value": 0.001, "units": "-",    "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Tan(Latitude) * Sin(AzT) * Tan(Inc)"},
    {"name": "GMIS","value": 0.05, "units": "deg",   "propagation_mode": "Systematic", "inc_max_deg": 17, "carry_above_max": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "1 / (Cos(Latitude) * Cos(Inc))"},

    {"name": "GRN",      "value": 0.1, "units": "deg/hr", "propagation_mode": "Random",     "inc_max_deg": 17, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sqr(1 - Cos(AzT) ^ 2 * Sin(Inc) ^ 2) / (EarthRate * Cos(Latitude) * Cos(Inc))"},
    {"name": "GRN-INIT", "value": 0.1, "units": "deg/hr", "propagation_mode": "Systematic", "inc_min_deg": 17, "carry_only": true, "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "NoiseReductionFactor * Sqr(1 - Cos(AzT) ^ 2 * Sin(Inc) ^ 2) / (EarthRate * Cos(Latitude) * Cos(Inc))"},

    {"name": "GXY-GD",  "value": 0.5,  "units": "deg/hr",      "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "XY_Gyro_Drift + (MD - MDPrev) / (GXYRunningSpeed * Sin((Inc + IncPrev) / 2))"},
    {"name": "GXY-GRW", "value": 0.5,  "units": "deg/sqr(hr)", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sqr(XY_Gyro_Random_Walk ^ 2 + (MD - MDPrev) / (GXYRunningSpeed * Sin((Inc + IncPrev) / 2) ^ 2))"},

    {"name": "MIS1", "value": 0.1, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Abs(Sin(Inc))", "azimuth_formula": "0"},
    {"name": "MIS2", "value": 0.1, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "-1"},
    {"name": "MIS3", "value": 0.2, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Abs(Cos(Inc)) * Cos(AzT)", "azimuth_formula": "-Abs(Cos(Inc)) * Sin(AzT) / Sin(Inc)", "north_singularity": "1"},
    {"name": "MIS4", "value": 0.2, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Abs(Cos(Inc)) * Sin(AzT)", "azimuth_formula": "Abs(Cos(Inc)) * Cos(AzT) / Sin(Inc)", "east_singularity": "1"},
    {"name": "VSAG", "value": 0.1, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Sin(Inc)", "azimuth_formula": "0"},

    {"name": "DRE", "value": 0.50,   "units": "m",   "propagation_mode": "Random",     "depth_formula": "1", "inclination_formula": "0", "azimuth_formula": "0"},
    {"name": "DSR", "value": 0.50,   "units": "m",   "propagation_mode": "Systematic", "depth_formula": "1", "inclination_formula": "0", "azimuth_formula": "0"},
    {"name": "DSC", "value": 0.001,  "units": "-",   "propagation_mode": "Well",       "depth_formula": "MD", "inclination_formula": "0", "azimuth_formula": "0"},
    {"name": "DST", "value": 5.0e-7, "units": "1/m", "propagation_mode": "Global",     "depth_formula": "TVD * MD", "inclination_formula": "0", "azimuth_formula": "0"}
  ]
}
