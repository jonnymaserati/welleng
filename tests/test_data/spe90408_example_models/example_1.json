{
  "metadata": {
    "short_name": "SPE90408-EX1",
    "long_name": "SPE 90408 Example Model #1 (XY accel + XY stationary gyro 0-150deg)",
    "source": "SPE 90408-MS Torkildsen et al. 2004, Appendix D Table D1/D7",
    "tool_type": "Gyroscopic",
    "revision_number": 5
  },
  "parameters": {
    "inc_min": 0,
    "inc_max": 150,
    "noise_reduction_factor": 1.0
  },
  "terms": [
    {"name": "AXY-B",  "value": 0.005,  "units": "m/s2",   "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "1 / (Gfield * Cos(Inc))", "azimuth_formula": "0"},
    {"name": "AXY-SF", "value": 0.0005, "units": "-",      "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Tan(Inc)", "azimuth_formula": "0"},
    {"name": "AXY-MIS","value": 0.05,   "units": "deg",    "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "1", "azimuth_formula": "0"},
    {"name": "AXY-GB", "value": 0.005,  "units": "m/s2",   "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Tan(Inc) / Gfield", "azimuth_formula": "0"},

    {"name": "GB1", "value": 0.1, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) / (EarthRate * Cos(Latitude) * Cos(Inc))"},
    {"name": "GB2", "value": 0.1, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) / (EarthRate * Cos(Latitude))"},
    {"name": "GRN", "value": 0.1, "units": "deg/hr", "propagation_mode": "Random",     "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "NoiseReductionFactor * Sqr(1 - Cos(AzT) ^ 2 * Sin(Inc) ^ 2) / (EarthRate * Cos(Latitude) * Cos(Inc))"},
    {"name": "GD1", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) * Sin(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GD2", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) * Cos(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GD3", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) / (EarthRate * Cos(Latitude))"},
    {"name": "GD4", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) * Tan(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GSF", "value": 0.001, "units": "-",    "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Tan(Latitude) * Sin(AzT) * Tan(Inc)"},
    {"name": "GMIS","value": 0.05, "units": "deg",   "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "1 / (Cos(Latitude) * Cos(Inc))"},

    {"name": "MIS1", "value": 0.1, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Abs(Sin(Inc))", "azimuth_formula": "0"},
    {"name": "MIS2", "value": 0.1, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "-1"},
    {"name": "MIS3", "value": 0.2, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Abs(Cos(Inc)) * Cos(AzT)", "azimuth_formula": "-Abs(Cos(Inc)) * Sin(AzT) / Sin(Inc)", "north_singularity": "1"},
    {"name": "MIS4", "value": 0.2, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Abs(Cos(Inc)) * Sin(AzT)", "azimuth_formula": "Abs(Cos(Inc)) * Cos(AzT) / Sin(Inc)", "east_singularity": "1"},
    {"name": "VSAG", "value": 0.1, "units": "deg", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "Sin(Inc)", "azimuth_formula": "0"},

    {"name": "DRE", "value": 0.50,   "units": "m",   "propagation_mode": "Random",     "depth_formula": "1", "inclination_formula": "0", "azimuth_formula": "0"},
    {"name": "DSR", "value": 0.50,   "units": "m",   "propagation_mode": "Systematic", "depth_formula": "1", "inclination_formula": "0", "azimuth_formula": "0"},
    {"name": "DSC", "value": 0.001,  "units": "-",   "propagation_mode": "Well",       "depth_formula": "MD", "inclination_formula": "0", "azimuth_formula": "0"},
    {"name": "DST", "value": 5.0e-7, "units": "1/m", "propagation_mode": "Global",     "depth_formula": "(TVD + MD * Cos(Inc)) * MD", "inclination_formula": "0", "azimuth_formula": "0"}
  ]
}
