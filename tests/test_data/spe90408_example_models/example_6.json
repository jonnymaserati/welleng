    {"name": "GD2", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Cos(AzT) * Cos(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "GD3", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) * Cos(Inc) ^ 2 / (EarthRate * Cos(Latitude))"},
