    {"name": "ZRN", "value": 0.1, "units": "deg/hr", "propagation_mode": "Random",     "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) * Sin(Inc) / (EarthRate * Cos(Latitude))"},
    {"name": "ZD1", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) * Sin(Inc) ^ 2 / (EarthRate * Cos(Latitude))"},
    {"name": "ZD2", "value": 0.5, "units": "deg/hr", "propagation_mode": "Systematic", "depth_formula": "0", "inclination_formula": "0", "azimuth_formula": "Sin(AzT) * Cos(Inc) * Sin(Inc) / (EarthRate * Cos(Latitude))"},
